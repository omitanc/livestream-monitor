{
  "name": "livestream-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube Live viewer-side monitoring for macOS and Windows",
  "author": "omitanc",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "preview": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "npm run typecheck && prettier --check .",
    "fmt": "prettier --write .",
    "package": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0",
    "prettier": "^3.8.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
